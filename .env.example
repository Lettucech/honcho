# Honcho self-host .env — generated 2026-06-25 by 胡桃
# Auth: loopback only (no JWT, port 127.0.0.1:8000)
AUTH_USE_AUTH=false

# === LLM (Deriver) — Local Ollama ===
# Honcho requires LLM_OPENAI_API_KEY to be set (any non-empty string)
# because the OpenAI transport checks for credentials even when pointing at a
# local proxy. The key itself is sent to the upstream — for Ollama, anything works.
LLM_OPENAI_API_KEY=<REDACTED>

# Deriver model config (nested via __ delimiter)
# transport=openai means OpenAI-compatible HTTP API
# base_url routes to Ollama's /v1 endpoint on the LAN
DERIVER_MODEL_CONFIG__TRANSPORT=openai
DERIVER_MODEL_CONFIG__MODEL=qwen3.5:9b-mlx
DERIVER_MODEL_CONFIG__OVERRIDES__BASE_URL=http://192.168.70.227:11434/v1
DERIVER_MODEL_CONFIG__OVERRIDES__API_KEY=<REDACTED>

# === Embedding — Local Ollama (nomic) ===
# nomic-embed-text is purpose-built for embeddings; qwen models do embeddings poorly
EMBEDDING_MODEL_CONFIG__TRANSPORT=openai
EMBEDDING_MODEL_CONFIG__MODEL=nomic-embed-text:latest
EMBEDDING_MODEL_CONFIG__OVERRIDES__BASE_URL=http://192.168.70.227:11434/v1
EMBEDDING_MODEL_CONFIG__OVERRIDES__API_KEY=<REDACTED>

# Embedding dimension must match the model. nomic-embed-text outputs 768.
# Honcho default is 1536 (text-embedding-3-small). Override below.
EMBEDDING_VECTOR_DIMENSIONS=768

# === Database (compose service name resolution) ===
# Use the docker compose service name 'database', not localhost.
DB_CONNECTION_URI=postgresql+psycopg://postgres:<REDACTED>@database:5432/postgres

# === Cache (Redis) ===
CACHE_URL=redis://redis:6379/0?suppress=true
CACHE_ENABLED=true

# === Misc ===
LOG_LEVEL=INFO
PERFORMANCE_LOG_FORMAT=compact
VECTOR_STORE_TYPE=pgvector
VECTOR_STORE_MIGRATED=false

# DERIVER sidecar runs alongside api in same compose.
# Required for memory formation; without it, messages store but no reasoning occurs.
DERIVER_ENABLED=true
DERIVER_WORKERS=1
# === Postgres password (loopback self-host) ===
POSTGRES_PASSWORD=<REDACTED>

# === Dreamer — MiMo v2.5 (pay-as-you-go) ===
# Dreamer needs stronger reasoning for cross-session synthesis
DREAM__DEDUCTION_MODEL_CONFIG__TRANSPORT=openai
DREAM__DEDUCTION_MODEL_CONFIG__MODEL=mimo-v2.5
DREAM__DEDUCTION_MODEL_CONFIG__OVERRIDES__BASE_URL=https://api.xiaomimimo.com/v1
DREAM__DEDUCTION_MODEL_CONFIG__OVERRIDES__API_KEY=<REDACTED>
DREAM__INDUCTION_MODEL_CONFIG__TRANSPORT=openai
DREAM__INDUCTION_MODEL_CONFIG__MODEL=mimo-v2.5
DREAM__INDUCTION_MODEL_CONFIG__OVERRIDES__BASE_URL=https://api.xiaomimimo.com/v1
DREAM__INDUCTION_MODEL_CONFIG__OVERRIDES__API_KEY=<REDACTED>
