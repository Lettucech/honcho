# Honcho self-host .env — 所有文字 pipeline 預設 override 做 MiMo v2.6-flash
# Usage: cp .env.example .env，補 <YOUR_MIMO_PAYG_KEY> 同 <POSTGRES_PASSWORD> 即用。
#
# 設計：
# - 全局 LLM_OPENAI_BASE_URL/API_KEY 指去 MiMo —— 任何 openai-transport pipeline
#   冇自己 overrides 時會自動繼承（src/llm/registry.py client_for_model_config fast path）
# - 文字 pipeline（deriver / summary / dialectic / dream）只 override model 名
# - embedding 例外：必須留本地 Ollama nomic-embed-text（768 維綁死 vector store schema）
# Auth: loopback only (no JWT, port 127.0.0.1:8000)
AUTH_USE_AUTH=false

# === 全局 LLM —— Xiaomi MiMo PAYG（OpenAI-compatible endpoint）===
# 呢條 key 係所有文字 pipeline 嘅預設憑據；rate limit 100 RPM / 10M TPM
# 按 model 計、全 account 加總，一條 key 夠成套 Honcho 用。
LLM_OPENAI_BASE_URL=https://api.xiaomimimo.com/v1
LLM_OPENAI_API_KEY=<YOUR_MIMO_PAYG_KEY>

# === Deriver（記憶形成：單次 structured output 抽取）===
# 量最大（~30-100 call/日），智力需求中低；nested config 用 __ 分隔
DERIVER_MODEL_CONFIG__TRANSPORT=openai
DERIVER_MODEL_CONFIG__MODEL=mimo-v2.6-flash

# === Summarizer（session 摘要：每 20/60 條 message 觸發）===
# 冇 set 會跌落 upstream 預設 gpt-5.4-mini @ OpenAI —— 呢度鎖死 MiMo
SUMMARY_MODEL_CONFIG__TRANSPORT=openai
SUMMARY_MODEL_CONFIG__MODEL=mimo-v2.6-flash

# === Dialectic（回憶問答：每 2 turn 一鑊，Honcho 最頻密 pipeline）===
# 5 個 reasoning level 全部 override，避免任何一個 level 跌落預設 gpt-5.4-mini
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__model=mimo-v2.6-flash
DIALECTIC_LEVELS__low__MODEL_CONFIG__model=mimo-v2.6-flash
DIALECTIC_LEVELS__medium__MODEL_CONFIG__model=mimo-v2.6-flash
DIALECTIC_LEVELS__high__MODEL_CONFIG__model=mimo-v2.6-flash
DIALECTIC_LEVELS__max__MODEL_CONFIG__model=mimo-v2.6-flash

# === Dreamer（跨 session 整合：deduction/induction 專家）===
# 智力需求最高；每 collection 最少 8 個鐘先夢一次
DREAM__DEDUCTION_MODEL_CONFIG__TRANSPORT=openai
DREAM__DEDUCTION_MODEL_CONFIG__MODEL=mimo-v2.6-flash
DREAM__INDUCTION_MODEL_CONFIG__TRANSPORT=openai
DREAM__INDUCTION_MODEL_CONFIG__MODEL=mimo-v2.6-flash

# === Embedding —— 本地 Ollama（唔好改做雲端）===
# nomic-embed-text 輸出 768 維；EMBEDDING_VECTOR_DIMENSIONS 同 pgvector schema 綁死，
# 換模型等於成個 vector store 重打。BASE_URL 改做你網絡入面嗰部 Ollama。
EMBEDDING_MODEL_CONFIG__TRANSPORT=openai
EMBEDDING_MODEL_CONFIG__MODEL=nomic-embed-text:latest
EMBEDDING_MODEL_CONFIG__OVERRIDES__BASE_URL=http://192.168.70.227:11434/v1
EMBEDDING_MODEL_CONFIG__OVERRIDES__API_KEY=<ANY_NONEMPTY_STRING>
# Embedding dimension must match the model. nomic-embed-text outputs 768.
EMBEDDING_VECTOR_DIMENSIONS=768

# === Database（compose service name resolution，唔好用 localhost）===
DB_CONNECTION_URI=postgresql+psycopg://postgres:<POSTGRES_PASSWORD>@database:5432/postgres

# === Cache（Redis）===
CACHE_URL=redis://redis:6379/0?suppress=true
CACHE_ENABLED=true

# === Misc ===
LOG_LEVEL=INFO
PERFORMANCE_LOG_FORMAT=compact
VECTOR_STORE_TYPE=pgvector
VECTOR_STORE_MIGRATED=false

# DERIVER sidecar runs alongside api in same compose.
# Required for memory formation; without it, messages store but no reasoning occurs.
DERIVER_ENABLED=true
DERIVER_WORKERS=1

# === Postgres password（database container 由呢度讀，亦填落上面 DB_CONNECTION_URI）===
POSTGRES_PASSWORD=<YOUR_POSTGRES_PASSWORD>
